{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@meterflow/shared": ["./packages/shared/src/index.ts"],
      "@meterflow/database": ["./packages/database/src/index.ts"]
    }
  },
  "exclude": [
    "node_modules",
    "dist",
    ".next",
    ".turbo"
  ]
}